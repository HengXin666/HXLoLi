# .agents/env/.env.example  本地依赖位置模板
#
# 用法:
#   cp .agents/env/.env.example .agents/env/.env
#   然后按本机实际路径填 .env (它被 .agents/.gitignore 屏蔽, 不会入库)
#
# 为什么用 .env 而不是写进 notes.config.json:
#   这些路径是**每台机器各不相同**的本地事实, 不该随仓库版本化 
#   否则换机器时会看到一份"别人机器的路径", 既误导又得改。
#   项目级配置 (哪些路径受门禁保护等) 才进 notes.config.json。

# ── note-triage 的依赖 (可选) ────────────────────────────────
# 不填时脚本会自己找; 找不到就打印一行跳过, 不阻塞。
# 填了可以省掉探测。

# typesafe_client.py 所在目录
HX_JEV_CLIENT_DIR=

# accounts json 路径
HX_JEV_ACCOUNTS=

# 探测时优先看的兄弟目录 (冒号分隔); 留空用内置基准
HX_JEV_SIBLING_ROOTS=

# 扫描基准目录 (冒号分隔); 设置后**覆盖**内置基准
HX_JEV_SCAN_BASES=
